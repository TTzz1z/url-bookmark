{
  "name": "url-bookmark",
  "version": "1.0.0",
  "private": true,
  "description": "本地优先的网址收藏、正文提取与 Markdown 阅读工具",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "qa:capture": "tsx scripts/capture-qa.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "db:seed:demo": "npm run db:migrate && tsx scripts/demo-data.ts seed",
    "db:clear:demo": "npm run db:migrate && tsx scripts/demo-data.ts clear"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@phosphor-icons/react": "2.1.10",
    "better-sqlite3": "13.0.2",
    "dompurify": "3.4.12",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "jsdom": "30.0.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "5.0.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
